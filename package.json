{
  "name": "thai-rtgs",
  "version": "0.1.0",
  "description": "Thai → Latin romanization using the Royal Thai General System of Transcription (RTGS). Rule-based syllable parser with an extensible dictionary. Zero dependencies.",
  "keywords": [
    "thai",
    "rtgs",
    "romanization",
    "transliteration",
    "transcription",
    "ภาษาไทย",
    "ถอดอักษร"
  ],
  "license": "MIT",
  "author": "PhaiKub",
  "homepage": "https://github.com/PhaiKub/thai-romanization-RTGS#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PhaiKub/thai-romanization-RTGS.git"
  },
  "bugs": {
    "url": "https://github.com/PhaiKub/thai-romanization-RTGS/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "eval": "tsx scripts/eval.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
